---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found – Michael Finn" noindex>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center px-4 sm:px-6">
    <p class="font-serif text-6xl font-bold text-accent dark:text-accent-soft">404</p>
    <h1 class="mt-4 text-2xl font-semibold">That page doesn't exist.</h1>
    <p class="mt-3 text-stone-600 dark:text-stone-400">
      It may have moved, or the link may have a typo.
    </p>
    <a href="/" class="mt-8 font-semibold text-accent underline-offset-4 hover:underline dark:text-accent-soft">
      Back to the home page
    </a>
  </main>
</BaseLayout>
