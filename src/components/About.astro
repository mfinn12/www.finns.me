---
import { employers, services } from '../data/site';
---

<section id="about" class="border-t border-stone-200 dark:border-stone-800">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-center">
    <img
      src="/images/me.JPG"
      alt="Portrait of Michael Finn"
      class="aspect-square w-full max-w-sm rounded-2xl object-cover shadow-sm"
      loading="lazy"
    />
    <div>
      <h2 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">
        A full-stack B2B marketing leader.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
        I'm a technology enthusiast with over two decades of marketing experience. I use deep
        technical expertise to plan and run marketing that grows the business.
      </p>
      <p class="mt-6 text-sm font-semibold tracking-widest text-stone-500 uppercase">Marketing leader at</p>
      <ul class="mt-3 flex flex-wrap gap-3">
        {
          employers.map((e) => (
            <li>
              <a
                href={e.href}
                target="_blank"
                rel="noopener"
                class="inline-block rounded-full border border-stone-300 px-4 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent dark:border-stone-700 dark:hover:border-accent-soft dark:hover:text-accent-soft"
              >
                {e.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section id="services" class="bg-stone-100 dark:bg-stone-900">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">What I do</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s, i) => (
          <li class="rounded-2xl bg-stone-50 p-6 shadow-sm ring-1 ring-stone-200 dark:bg-stone-950 dark:ring-stone-800">
            <span class="font-serif text-sm font-bold text-accent dark:text-accent-soft">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-400">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
