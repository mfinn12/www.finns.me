---
import { portfolio } from '../data/portfolio';
---

<section id="portfolio">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">Selected work</h2>
    <p class="mt-4 max-w-2xl text-lg text-stone-600 dark:text-stone-400">
      Samples from product marketing, demand generation and communications projects.
    </p>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        portfolio.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-1 hover:shadow-md dark:bg-stone-900 dark:ring-stone-800"
            >
              <div class="flex aspect-[7/4] items-center justify-center overflow-hidden bg-white">
                <img
                  src={item.image}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                {item.client && (
                  <span class="text-xs font-semibold tracking-widest text-stone-500 uppercase">
                    {item.client}
                  </span>
                )}
                <h3 class="mt-1 text-lg font-semibold group-hover:text-accent dark:group-hover:text-accent-soft">
                  {item.title}
                  <span class="sr-only"> (opens in a new tab)</span>
                </h3>
                <p class="mt-2 text-stone-600 dark:text-stone-400">{item.description}</p>
                <p class="mt-3 text-sm text-stone-500">{item.role}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
